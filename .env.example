# Внешние порты используются только в docker-compose.override.yml для доступа с хоста.
# Пример: NGINX_EXTERNAL_PORT=8080 означает, что приложение откроется на http://localhost:8080.
NGINX_EXTERNAL_PORT=8080
BACKEND_EXTERNAL_PORT=8001
POSTGRES_EXTERNAL_PORT=5432

# Доступы PostgreSQL для основной базы данных приложения.
POSTGRES_DB=your_postgres_db
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password

# Настройки JWT для access и refresh токенов.
# Формат срока жизни: число + единица, например 15m, 12h, 1d, 1w.
AUTH_JWT_SECRET=your_jwt_secret
AUTH_ACCESS_TOKEN_TTL=1d
AUTH_REFRESH_TOKEN_TTL=1w

# Стартовый суперадмин, которого db-init создаёт при инициализации базы.
# Имя и фамилия необязательны и могут оставаться пустыми.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=your_superadmin_password
SUPERADMIN_FIRST_NAME=
SUPERADMIN_LAST_NAME=

# Продуктовые лимиты, которые проверяются бизнес-логикой backend.
CHAT_MAX_PINNED_SESSIONS=5
SESSION_MAX_FILES=100
USER_MAX_AGENTS=50

# Основной LLM-провайдер для генерации гипотез, дебатов, оценок, вердикта судьи и промптов агентов.
# Для OpenAI-compatible провайдеров оставляйте MODEL_PROVIDER_FOLDER_ID= пустым.
# Для Yandex AI Studio укажите Yandex folder_id и используйте id моделей вида gpt://... либо оставьте пустым и укажите в панели управления в выпадающем списке.
MODEL_PROVIDER_BASE_URL=your_model_provider_base_url
MODEL_PROVIDER_API_KEY=your_model_provider_api_key
MODEL_PROVIDER_MODEL=your_model_provider_model
MODEL_PROVIDER_FOLDER_ID=

# Режим API для генерации текста основным LLM-провайдером.
# chat_completions использует /chat/completions и является самым безопасным вариантом для большинства OpenAI-compatible прокси.
# responses использует /responses; выбирайте его только если провайдер явно поддерживает OpenAI Responses API.
# Embedding-провайдеры не используют эту настройку, потому что эмбеддинги всегда запрашиваются через /embeddings.
MODEL_PROVIDER_API_MODE=chat_completions

# Embedding-провайдер для чанков документов и семантического поиска.
# Для него не нужен MODEL_PROVIDER_API_MODE, потому что эмбеддинги не являются запросами генерации текста.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=your_embedding_api_key
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_FOLDER_ID=

# Browser origins, которым разрешено напрямую обращаться к backend.
# Добавляйте локальные Vite origins для разработки frontend и production-домены frontend для деплоя.
BACKEND_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://frontend.example.com

# Hostnames, которые принимает frontend dev server/container.
# Пример: FRONTEND_ALLOWED_HOSTS=frontend.example.com
FRONTEND_ALLOWED_HOSTS=frontend.example.com
